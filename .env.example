# ==============================================================================
# PNG5 NOMOS — Global Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting services: cp .env.example .env
# NEVER commit real production secrets or API keys to version control.

# --- Policy Governor Daemon (FastAPI Backend, Port 8000) ---
GOVERNOR_URL=http://localhost:8000
GOVERNOR_HOST=127.0.0.1
GOVERNOR_PORT=8000
DB_PATH=governor.db

# --- Cryptographic API Keys (HMAC / Authorization Grants) ---
ORCHESTRATOR_KEY=orch_key_secret_123
REVIEWER_KEY=rev_key_secret_456
ADMIN_KEY=admin_key_secret_789

# --- MCP Gateway & Monaco IDE Server (Node.js, Port 3000) ---
PORT=3000
PROJECT_ROOT=.
COMMAND_TIMEOUT=5000
MAX_FILE_READ_SIZE=1048576
MAX_FILE_WRITE_SIZE=524288

# --- Optional AI Providers (Fallback Heuristic Engine is Active by Default) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Environment Mode ---
NODE_ENV=production
PYTHONUNBUFFERED=1
